# העתק ל-frontend/.env (נמצא ב-.gitignore). משתני VITE_* נכנסים ל-bundle ונראים לכולם: בלי סודות.

# כתובת ה-REST של ה-backend. ריק = אותו origin.
# ב-dev השאר ריק: Vite מעביר /api ו-/socket.io ל-VITE_BACKEND_URL (proxy).
# בפריסה לדומיין אחר: כתובת מלאה (https://...) ולעדכן CORS_ORIGIN ב-backend.
VITE_API_URL=

# כתובת Socket.IO. ריק = אותו origin.
VITE_SOCKET_URL=

# יעד ה-proxy של שרת הפיתוח (npm run dev) בלבד. נקרא ב-vite.config.ts, לא נכנס ל-bundle.
VITE_BACKEND_URL=http://localhost:4000
