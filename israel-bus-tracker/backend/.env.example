# פורט השרת
PORT=4000

# מקורות מותרים ל-CORS (מופרדים בפסיק). השאר "*" לפיתוח.
CORS_ORIGIN=*

# מצב הדגמה: מדמה אוטובוסים בתל אביב (ברירת מחדל כשאין כתובת פיד).
# הגדר false כדי לעבוד מול פיד GTFS-RT אמיתי.
DEMO_MODE=true

# כתובות פיד GTFS-RT (Protobuf). נדרשות רק כש-DEMO_MODE=false
VEHICLE_POSITIONS_URL=
TRIP_UPDATES_URL=

# מפתח API (אופציונלי) - נשלח ככותרת ו/או כפרמטר בכתובת
GTFS_API_KEY=
GTFS_API_KEY_HEADER=x-api-key
GTFS_API_KEY_PARAM=

# קובץ JSON עם נתוני GTFS סטטיים (routes + stops). ראה README לפורמט.
STATIC_DATA_PATH=

# תדירות משיכה (מילישניות)
POLL_INTERVAL_MS=3000

# אחרי כמה זמן ללא עדכון רכב נחשב "לא זמין" (מילישניות)
VEHICLE_STALE_MS=120000
