# ============================================================================
# מפת משתני הסביבה של כל הפרויקט (אינדקס). אין לטעון קובץ זה ישירות.
# כל חבילה קוראת את הקובץ שלה:
#   backend/.env.example   -> backend/.env    שרת. כאן יושבים מפתחות ה-API האמיתיים, רק בשרת.
#   frontend/.env.example  -> frontend/.env   web (Vite). ערכים ציבוריים בלבד, נכנסים ל-bundle.
#   mobile/.env.example    -> mobile/.env     אפליקציה (Expo). ערכים ציבוריים בלבד, נכנסים לבנדל.
# קבצי .env עצמם נמצאים ב-.gitignore. לעולם לא לעשות להם commit.
#
# כלל: כל משתנה שמתחיל ב-EXPO_PUBLIC_ או VITE_ נראה לכל מי שמפרק את האפליקציה/הדף.
#      לא שמים בהם סודות. סודות (SIRI_KEY, GTFS_API_KEY) רק ב-backend/.env.
# ============================================================================

# ---------------------------------------------------------------------------
# backend/.env  (תיאור מלא: backend/.env.example)
# ---------------------------------------------------------------------------
# --- שרת ---
PORT=4000
# בפרודקשן: רשימת origin מפורשת מופרדת בפסיק, לא "*"
CORS_ORIGIN=*

# --- מצב ---
# true = אוטובוסים מדומים בתל אביב. גם אם false, בלי כתובת פיד/SIRI השרת חוזר ל-demo.
DEMO_MODE=true

# --- GTFS-RT (protobuf) ---
VEHICLE_POSITIONS_URL=
TRIP_UPDATES_URL=
GTFS_API_KEY=
GTFS_API_KEY_HEADER=x-api-key
GTFS_API_KEY_PARAM=
# קובץ JSON של נתוני GTFS סטטיים (routes + stops)
STATIC_DATA_PATH=

# --- SIRI-SM (משרד התחבורה) ---
SIRI_SM_URL=
SIRI_KEY=
SIRI_KEY_PARAM=Key
SIRI_KEY_HEADER=
SIRI_MIN_REFRESH_MS=10000
SIRI_HOT_STOP_TTL_MS=120000
SIRI_WARM_STOP_IDS=

# --- תזמון ---
REQUEST_TIMEOUT_MS=10000
POLL_INTERVAL_MS=3000
VEHICLE_STALE_MS=120000

# ---------------------------------------------------------------------------
# frontend/.env  (תיאור מלא: frontend/.env.example)
# ---------------------------------------------------------------------------
# כתובת ה-REST. ריק = אותו origin (ב-dev: ה-proxy של Vite).
VITE_API_URL=
# כתובת Socket.IO. ריק = אותו origin.
VITE_SOCKET_URL=
# יעד ה-proxy של שרת הפיתוח של Vite בלבד (vite.config.ts). לא נכנס ל-bundle.
VITE_BACKEND_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# mobile/.env  (תיאור מלא: mobile/.env.example)
# ---------------------------------------------------------------------------
# כתובת ה-backend (REST). חובה ב-release, ורק https://
EXPO_PUBLIC_API_URL=
# כתובת Socket.IO. אם ריק, נלקחת כתובת ה-API.
EXPO_PUBLIC_SOCKET_URL=
# מפתחות Google Maps (client, ציבוריים; להגביל ב-Google Cloud לפי package name + SHA-1)
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
# פיתוח בלבד (__DEV__): 1 = ספקי Mock. מתעלמים ממנו ב-release.
EXPO_PUBLIC_USE_MOCK_PROVIDERS=

# ---------------------------------------------------------------------------
# אימות (authentication) וספק סליקה (payment provider)
# ---------------------------------------------------------------------------
# אין משתני סביבה לשניהם, כי אין להם מימוש: אין שירות חשבונות ואין ספק סליקה מחובר
# (ראה docs/FEATURE_STATUS.md, NOT_IMPLEMENTED). לא ממציאים כאן משתנים לפני שיש מימוש.
# כשיתווספו: מפתח publishable בלבד יכול להיכנס ל-mobile (EXPO_PUBLIC_*).
# מפתח secret של ספק סליקה, וסודות אימות (JWT/OAuth client secret) - רק ב-backend/.env.
# ב-CI: משתני mobile מוגדרים כ-Variables ומפתח Maps כ-Secret (GOOGLE_MAPS_ANDROID_KEY).
