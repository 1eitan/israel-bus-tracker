# העתק ל-mobile/.env (נמצא ב-.gitignore). כל משתנה EXPO_PUBLIC_* נכנס לבנדל ונראה לכל מי שמפרק את האפליקציה:
# לעולם לא לשים כאן סודות (מפתחות secret, סיסמאות, טוקנים של ספק סליקה). רק ערכים ציבוריים.

# כתובת ה-backend (REST). חובה ב-release, ורק https://. בפיתוח, אם ריק: http://localhost:4000
# במכשיר פיזי localhost הוא המכשיר עצמו - השתמש בכתובת ה-LAN של המחשב (למשל http://192.168.1.20:4000).
EXPO_PUBLIC_API_URL=

# כתובת Socket.IO. אם ריק, נלקחת כתובת ה-API.
EXPO_PUBLIC_SOCKET_URL=

# מפתחות Google Maps (מפתח client ציבורי, בכל זאת: הגבל אותו ב-Google Cloud לפי package name + SHA-1).
# בלי מפתח תקין (AIza...) המפה לא מוצגת והאפליקציה ממשיכה לעבוד.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=

# פיתוח בלבד (__DEV__): 1 = ספקי Mock (תשלום/מסלול/התחברות מדומים, מסומנים "הדגמה"). מתעלמים ממנו ב-release.
EXPO_PUBLIC_USE_MOCK_PROVIDERS=
